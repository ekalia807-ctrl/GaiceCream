# Salin file ini menjadi .env.local lalu isi nilainya (lihat SETUP.md).
# Di Supabase: Project Settings > API (atau API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Pakai "anon key" atau "publishable key" (boleh dilihat publik; keamanan dijaga oleh RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# JANGAN pernah memakai service_role key di variabel NEXT_PUBLIC_*.
